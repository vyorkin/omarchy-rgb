#!/usr/bin/env bash
# omarchy-rgb — one knob for every light this machine exposes.
#
# Targets, in the order they are touched:
#   1. OpenRGB devices (motherboard ARGB headers, graphics card) — CLI, -b percent;
#   2. Lian Li devices (AIO pump and fans, wireless strips and fans) — the
#      daemon's Unix-socket IPC (newline-delimited JSON), which applies effects
#      instantly and needs no daemon restart;
#   3. the AIO screen's backlight — the same IPC, SetLcdBrightness;
#   4. the 8.8" case panel — `bezel brightness`.
#
# RAM modules are deliberately out of scope: their RGB sits behind the ENE
# SMBus controller, and writing to it has a history of damaging DDR5 modules.
#
# Commands:
#   omarchy-rgb status [--json]   print the current state
#   omarchy-rgb set <0..100>      set every light to a percentage
#   omarchy-rgb on                restore the last non-zero brightness
#   omarchy-rgb off               turn everything off, remembering the level
#   omarchy-rgb toggle            off when anything is on, on otherwise
#
# State lives in ${XDG_STATE_HOME:-~/.local/state}/omarchy-rgb/state.json.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-rgb"
STATE_FILE="$STATE_DIR/state.json"
LIANLI_SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/lianli-daemon.sock"
OMARCHY_COLORS="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"

# Devices by name as OpenRGB reports them. Add or remove lines to taste; the
# widget never touches anything not listed here.
OPENRGB_DEVICES=(
    "ASRock X870 Pro RS WiFi"
    "MSI GeForce RTX 5080 Gaming Trio OC"
)

# Lian Li devices are not listed by hand: they come from the daemon's config, so
# strips that appear later are picked up on their own.
AIO_LCD_DEVICE="hid:0416:7395:8-12"

die() { printf 'omarchy-rgb: %s\n' "$*" >&2; exit 1; }
log() { printf 'omarchy-rgb: %s\n' "$*" >&2; }

# --- theme accent -------------------------------------------------------------

accent_hex() {
    local accent
    accent=$(omarchy-theme-color --file "$OMARCHY_COLORS" accent 2>/dev/null | tr -d '"' || true)
    [[ $accent =~ ^#[0-9a-fA-F]{6}$ ]] || accent="#ffffff"
    printf '%s' "$accent"
}

# --- state --------------------------------------------------------------------
#
# The file is flat and written by bash on purpose: every field used to be read by
# a python process of its own, and four of those per slider step cost more than
# the hardware work below. The Lian Li colour base lives in its own file, so this
# one can be rewritten wholesale without losing anything.
STATE_FILE="$STATE_DIR/state.json"
LIANLI_COLORS="$STATE_DIR/lianli-colors.json"
GUARD_CACHE="$STATE_DIR/lianli-guard.json"

state_default() { printf '{"on":true,"brightness":100,"generation":0,"fast_percent":-1}'; }

state_read() {
    if [[ -r $STATE_FILE ]]; then cat "$STATE_FILE"; else state_default; fi
}

# state_get <field> — печатает значение поля или пусто.
state_get() {
    local field=$1
    [[ -r $STATE_FILE ]] || return 0
    sed -n "s/.*\"$field\": *\(\"[^\"]*\"\|[^,}]*\).*/\1/p" "$STATE_FILE" | tr -d '"' | head -n1
}

# shift_state_field <field> <value> — меняет одно поле, остальные не трогает.
shift_state_field() {
    local field=$1 value=$2 body new
    body=$(state_read)
    if printf '%s' "$body" | grep -q "\"$field\":"; then
        new=$(printf '%s' "$body" | sed "s/\"$field\":[^,}]*/\"$field\":$value/")
    else
        new=$(printf '%s' "$body" | sed "s/}$/,\"$field\":$value}/")
    fi
    printf '%s\n' "$new" >"$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

state_mark_applied() { shift_state_field openrgb_applied "${1:-0}"; }
state_mark_fast() { shift_state_field fast_percent "${1:-0}"; }

# state_write <on> <brightness> — печатает номер изменения.
state_write() {
    local on=$1 brightness=$2 generation previous_fast
    generation=$(date +%s%N)
    previous_fast=$(state_get fast_percent)
    [[ $previous_fast =~ ^-?[0-9]+$ ]] || previous_fast=-1
    mkdir -p "$STATE_DIR"
    printf '{"on":%s,"brightness":%s,"generation":"%s","fast_percent":%s}\n' \
        "$on" "$brightness" "$generation" "$previous_fast" >"$STATE_FILE.tmp"
    mv "$STATE_FILE.tmp" "$STATE_FILE"
    printf '%s' "$generation"
}

# --- Lian Li IPC --------------------------------------------------------------
#
# Everything Lian Li goes through the daemon's Unix socket: newline-delimited
# JSON, one response per request. Writes must carry a WriteGuard — the daemon
# refuses anonymous changes — and the guard is cached on disk, because asking for
# it costs a round trip on every slider step. The guard only changes when the
# daemon restarts, and a stale one is retried once with a fresh copy.
#
# Brightness is applied through the colour, not the firmware level: that scale has
# only five steps, so 3% would become 25% and stay bright. The level stays at
# maximum and the zone colours are multiplied instead. The untouched colours are
# remembered per zone in their own file — the state file is flat and owned by bash
# — so the scaling never compounds, and a colour change made elsewhere (a theme
# switch, the Lian Li GUI) becomes the new base.
#
# The cooler screen's backlight rides along in the same process and on the same
# connection: a second call cost another process and another round trip.
lianli_available() {
    [[ -S $LIANLI_SOCKET ]] && command -v python3 >/dev/null 2>&1
}

# lianli_apply <percent>
lianli_apply() {
    local percent=${1:-0} out
    lianli_available || return 0
    [[ $percent =~ ^[0-9]+$ ]] || percent=0
    out=$(python3 - "$LIANLI_SOCKET" "$LIANLI_COLORS" "$percent" "$(accent_hex)" \
        "$GUARD_CACHE" "$AIO_LCD_DEVICE" <<'INNER'
import json
import os
import socket
import sys

socket_path, colors_path, percent_raw, accent, guard_cache, lcd_device = sys.argv[1:7]
percent = max(0, min(100, int(float(percent_raw))))
accent = accent.lstrip("#")


def call(request, connection=None):
    """One request, one response line."""
    own = connection is None
    if own:
        try:
            connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            connection.settimeout(6)
            connection.connect(socket_path)
        except OSError as error:
            return {"status": "error", "message": str(error)}
    try:
        connection.sendall(json.dumps(request).encode() + b"\n")
        buf = b""
        while b"\n" not in buf:
            chunk = connection.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf.decode(errors="replace"))
    except (OSError, ValueError) as error:
        return {"status": "error", "message": str(error)}
    finally:
        if own:
            connection.close()


def read_json(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def write_json(path, payload):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".tmp", "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False)
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def make_guard():
    info = call({"method": "GetDaemonInfo"})
    if info.get("status") != "ok":
        return None
    daemon = info["data"]
    guard = {
        "client_version": daemon.get("version"),
        "protocol_version": daemon.get("protocol_version"),
        "instance_id": daemon.get("instance_id"),
    }
    write_json(guard_cache, guard)
    return guard


cached = read_json(guard_cache)
guard = cached if cached.get("instance_id") else make_guard()
if not guard:
    print("daemon did not answer")
    sys.exit(0)

connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
connection.settimeout(6)
try:
    connection.connect(socket_path)
except OSError as error:
    print(f"cannot reach the daemon: {error}")
    sys.exit(0)


def write(request):
    global guard
    response = call(request, connection)
    if response.get("status") != "ok" and "daemon changed" in str(response.get("message", "")).lower():
        renewed = make_guard()
        if renewed:
            guard = renewed
            response = call(request, connection)
    if response.get("status") != "ok":
        print(response.get("message", "write rejected"))
    return response


def guarded(request):
    return {"method": "Guarded", "params": {"guard": guard, "request": request}}


config = call({"method": "GetConfig"}, connection)
if config.get("status") != "ok":
    print(config.get("message", "cannot read the daemon config"))
    connection.close()
    sys.exit(0)

rgb = config["data"].get("rgb")
accent_rgb = [int(accent[index:index + 2], 16) for index in (0, 2, 4)]
scale = percent / 100.0

if rgb and rgb.get("devices"):
    for device_entry in rgb.get("devices", []):
        device_id = device_entry.get("device_id", "")
        for zone in device_entry.get("zones", []):
            effect = dict(zone.get("effect") or {})
            # Основой всегда служит акцент темы — тот же цвет, что ставит хук темы.
            # Раньше мы запоминали цвета из конфига, но туда попадали наши же
            # затемнённые значения, база «отравлялась» и свет переставал
            # разгораться. Один источник истины надёжнее.
            effect["colors"] = [
                [max(0, min(255, round(channel * scale))) for channel in accent_rgb]
            ]
            # Уровень держим максимальным: яркость задаётся цветом.
            effect["brightness"] = 4 if percent > 0 else 0
            effect["disabled"] = percent <= 0
            zone["effect"] = effect

    # Одна запись на все устройства: демон сам разворачивает области и регионы.
    # Сырой SetRgbEffect для лент не годится — он отвергает Static вне их области.
    write(guarded({"method": "SetRgbConfig", "params": {"config": rgb}}))

write(guarded({
    "method": "SetLcdBrightness",
    "params": {"device_id": lcd_device, "brightness": percent},
}))
connection.close()
INNER
)
    [[ -n $out ]] && log "Lian Li: $(printf '%s' "$out" | head -c 200)"
    return 0
}

# --- OpenRGB ------------------------------------------------------------------

# Every `openrgb` run detects the whole machine again: about three seconds per
# device, and the two devices are applied one after the other. Doing that while
# the user waits is what made the slider feel dead, so the work is handed to a
# detached worker: the fast targets (Lian Li, the cooler screen, the case panel)
# answer in tens of milliseconds and the board catches up in the background.
#
# A lock makes a drag collapse into one write: the worker reads the *current*
# state when it gets the lock, not the value it was started with, so twenty
# intermediate levels turn into a single final one.
OPENRGB_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-rgb-openrgb.lock"

# Быстрый путь: сервер OpenRGB держит устройства открытыми, и запись цвета уходит
# за миллисекунды вместо трёх секунд опроса в CLI (см. bin/openrgb-fast.py).
PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OPENRGB_HELPER="$PLUGIN_DIR/bin/openrgb-fast.py"
OPENRGB_CACHE="$STATE_DIR/openrgb-devices.json"

openrgb_fast() {
    local percent=$1
    [[ -x $OPENRGB_HELPER ]] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    "$OPENRGB_HELPER" apply "$percent" "$(accent_hex)" "${OPENRGB_DEVICES[@]}" 2>/dev/null
}

# Сервер ещё не поднят — поднимаем его в фоне, чтобы следующее движение
# ползунка уже не ждало нескольких секунд детекции.
openrgb_warmup() {
    [[ -x $OPENRGB_HELPER ]] || return 0
    [[ -f $OPENRGB_CACHE ]] && return 0
    ( "$OPENRGB_HELPER" warmup "${OPENRGB_DEVICES[@]}" >/dev/null 2>&1 & ) 2>/dev/null
    return 0
}

# OpenRGB и яркость: у ASRock режим Static объявлен как
# MODE_FLAG_HAS_PER_LED_COLOR без флага яркости, поэтому `-b` он игнорирует —
# лента на ARGB-разъёме остаётся яркой. Яркость здесь тоже задаётся цветом:
# акцент темы умножается на процент. `-b` всё равно передаём: драйверам, которые
# флаг поддерживают, это не мешает.
openrgb_color_for() {
    local percent=$1
    python3 - "$(accent_hex)" "$percent" <<'PY'
import sys

accent, percent = sys.argv[1].lstrip("#"), max(0, min(100, int(float(sys.argv[2]))))
scale = percent / 100.0
channels = [int(accent[index:index + 2], 16) for index in (0, 2, 4)]
print("".join(f"{max(0, min(255, round(channel * scale))):02x}" for channel in channels))
PY
}

openrgb_render() {
    local percent=$1 accent device
    accent=$(openrgb_color_for "$percent")
    for device in "${OPENRGB_DEVICES[@]}"; do
        if (( percent <= 0 )); then
            # Off, rather than a black colour: some ASRock modes would otherwise
            # keep the last colours and stay lit.
            timeout 60 openrgb --noautoconnect -d "$device" -m Off >/dev/null 2>&1 \
                || log "OpenRGB: не удалось выключить '$device'"
        else
            timeout 60 openrgb --noautoconnect -d "$device" -m Static -c "$accent" -b "$percent" \
                >/dev/null 2>&1 \
                || log "OpenRGB: не удалось применить яркость к '$device'"
        fi
    done
}

openrgb_apply_state() {
    local on brightness
    on=$(state_get on)
    brightness=$(state_get brightness)
    [[ -n $on ]] || on=true
    [[ -n $brightness ]] || brightness=100
    if [[ $on == false || $brightness == 0 ]]; then
        openrgb_render 0
    else
        openrgb_render "$brightness"
    fi
}

openrgb_async() {
    local spawn_generation=${1:-}
    command -v openrgb >/dev/null 2>&1 || return 0
    (
        flock 9 || exit 0

        # Драгоценная пауза: пока предыдущий вызов дописывает плату, ползунок
        # успевает уехать дальше, и почти все воркеры выйдут, так и не тронув
        # железо. Без неё каждый промежуточный шаг перезаписывает ленту.
        sleep 0.35

        # Нас обогнали: ползунок уехал дальше, и свежий воркер применит новое
        # значение. Работать здесь — это ещё одна перезапись платы, а каждая
        # такая перезапись видна как короткое мигание ленты.
        local current applied
        current=$(state_get generation)
        [[ -n $spawn_generation && -n $current && $spawn_generation != "$current" ]] && exit 0

        applied=$(state_get openrgb_applied)
        [[ -n $current && $current == "$applied" ]] && exit 0

        openrgb_apply_state
        state_mark_applied "$current"
    ) 9>>"$OPENRGB_LOCK" &
}

# --- 8.8" panel ---------------------------------------------------------------

bezel_apply() {
    local percent=$1
    command -v bezel >/dev/null 2>&1 || return 0
    timeout 30 bezel brightness "$percent" >/dev/null 2>&1 || true
}

# --- commands -----------------------------------------------------------------

# wait_limited <milliseconds> <pids...> — ждём не дольше указанного, оставшиеся дети
# продолжают работать и доедут сами.
wait_limited() {
    local ms=$1
    shift
    local ticks=$(( ms / 10 ))
    (( ticks < 1 )) && ticks=1
    local tick=0 alive pid
    while (( tick < ticks )); do
        alive=0
        for pid in "$@"; do
            kill -0 "$pid" 2>/dev/null && alive=1
        done
        (( alive == 0 )) && return 0
        sleep 0.01
        tick=$(( tick + 1 ))
    done
    return 0
}

apply_all() {
    local on=$1 brightness=$2 generation=${3:-}
    local percent=$brightness
    (( percent < 0 )) && percent=0
    # Выключено — значит ноль на всех целях. В состоянии при этом остаётся
    # последняя яркость, чтобы кнопка «включить» знала, куда возвращаться.
    [[ $on == false ]] && percent=0

    # Шаг 5% для быстрых целей: ленты и экраны получают заметно меньше
    # перерисовок, а глаз разницы между 40% и 42% всё равно не видит. Плата ниже
    # берёт точное значение — она и так применяется в фоне.
    # Мелкие значения не округляем: 3% должны остаться 3%, а не превратиться
    # в 5% — именно на низах шаг заметнее всего.
    local fast
    if (( percent <= 10 )); then
        fast=$percent
    else
        fast=$(( (percent + 2) / 5 * 5 ))
        (( fast > 100 )) && fast=100
    fi
    (( percent == 0 )) && fast=0

    local last_fast
    last_fast=$(state_get fast_percent)
    if [[ $last_fast != "$fast" || ${OMARCHY_RGB_FORCE:-0} == 1 ]]; then
        local pids=()
        lianli_apply "$fast" & pids+=($!)
        bezel_apply "$fast" & pids+=($!)
        # Ждём не дольше 150 мс. Демон Lian Li иногда занят заливкой кадров по
        # радио и держит очередь до секунды — интерфейс из-за этого дёргаться не
        # должен: не дождались, значит значение доедет в фоне.
        wait_limited 150 "${pids[@]}"
        state_mark_fast "$fast"
    fi

    # Плата: одна команда, когда сервер уже поднят. Если его нет — фоновый опрос
    # CLI плюс подъём сервера для следующих движений ползунка.
    if ! openrgb_fast "$percent"; then
        openrgb_warmup
        openrgb_async "$generation"
    fi
    return 0
}

state_set() {
    python3 - "$STATE_FILE" "$1" "${2:-}" <<'PY'
import json
import os
import sys

path, key, raw = sys.argv[1:4]
try:
    with open(path, encoding="utf-8") as handle:
        state = json.load(handle)
except (OSError, ValueError):
    state = {}
try:
    state[key] = json.loads(raw)
except ValueError:
    state[key] = raw
with open(path + ".tmp", "w", encoding="utf-8") as handle:
    json.dump(state, handle, ensure_ascii=False)
os.replace(path + ".tmp", path)
PY
}

state_mark_applied() { state_set openrgb_applied "${1:-}"; }
state_mark_fast() { state_set fast_percent "${1:-}"; }

read_state_field() {
    python3 - "$(state_read)" "$1" <<'PY'
import json
import sys

try:
    state = json.loads(sys.argv[1])
except ValueError:
    state = {}
value = state.get(sys.argv[2])
if isinstance(value, bool):
    print("true" if value else "false")
elif value is None:
    print("")
else:
    print(value)
PY
}

cmd_status() {
    local json=0
    [[ ${1:-} == --json ]] && json=1
    local on brightness accent
    on=$(state_get on)
    brightness=$(state_get brightness)
    [[ -n $on ]] || on=true
    [[ -n $brightness ]] || brightness=100
    accent=$(accent_hex)
    if (( json )); then
        printf '{"on":%s,"brightness":%s,"accent":"%s"}\n' "$on" "$brightness" "$accent"
    else
        if [[ $on == true ]]; then
            printf 'lights on, %s%%, accent %s\n' "$brightness" "$accent"
        else
            printf 'lights off (last level %s%%)\n' "$brightness"
        fi
    fi
}

cmd_set() {
    local percent=${1:-}
    [[ $percent =~ ^[0-9]+$ ]] || die "яркость должна быть целым числом 0..100"
    (( percent >= 0 && percent <= 100 )) || die "яркость должна быть 0..100"

    local on=true
    if (( percent <= 0 )); then
        on=false
        # Off keeps the previous level, so `on` has something to restore.
        local last
        last=$(state_get brightness)
        [[ -n $last && $last != 0 ]] || last=100
        brightness=$last
    else
        brightness=$percent
    fi

    # Ничего не изменилось — не трогаем железо вовсе: повторная запись того же
    # значения заставляет ленты и плату перерисоваться, и это видно.
    if [[ ${OMARCHY_RGB_FORCE:-0} != 1 ]]; then
        local was_on was_brightness
        was_on=$(state_get on)
        was_brightness=$(state_get brightness)
        if [[ ${was_on:-true} == "$on" && ${was_brightness:-} == "$brightness" ]]; then
            return 0
        fi
    fi

    # Состояние записано до запуска работ: фоновый OpenRGB-воркер читает именно
    # его, поэтому при перетаскивании ползунка применяется последнее значение.
    local generation
    generation=$(state_write "$on" "$brightness")
    apply_all "$on" "$brightness" "$generation"
}

cmd_on() {
    local last
    last=$(state_get brightness)
    [[ -n $last && $last != 0 ]] || last=100
    cmd_set "$last"
}

cmd_off() { cmd_set 0; }

cmd_toggle() {
    local on
    on=$(state_get on)
    [[ -n $on ]] || on=true
    if [[ $on == true ]]; then cmd_off; else cmd_on; fi
}

case "${1:-status}" in
    status) shift || true; cmd_status "${1:-}" ;;
    set) shift || true; cmd_set "${1:-}" ;;
    on) cmd_on ;;
    off) cmd_off ;;
    toggle) cmd_toggle ;;
    accent) accent_hex ;;
    -h|--help|help)
        sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *) die "неизвестная команда '${1}'" ;;
esac
